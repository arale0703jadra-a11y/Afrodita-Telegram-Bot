# Token propio de AFRODITA. No reutilizar el token de ZEUS.
AFRODITA_BOT_TOKEN=

# Opcional: ruta para el estado persistente de AFRODITA. Monta aquí el volumen
# persistente del servicio si se despliega en Railway.
AFRODITA_DATA_DIR=

# Configuración opcional de IA: si se define una, deben definirse las tres.
AFRODITA_AI_CHAT_COMPLETIONS_URL=
AFRODITA_AI_API_KEY=
AFRODITA_AI_MODEL=

# Opcional: directorio que contiene los archivos locales de ZEUS
# data/storage/<chatId>.json. Sin acceso a esos archivos los perfiles fallan
# de forma segura y no se presentarán.
AFRODITA_ZEUS_STORAGE_DIR=
