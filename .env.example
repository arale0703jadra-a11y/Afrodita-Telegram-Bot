# Obligatorio: token propio de AFRODITA. No reutilizar el token de ZEUS.
AFRODITA_BOT_TOKEN=

# Opcional: ruta para el estado persistente de AFRODITA. Monta aquí el volumen
# persistente del servicio si se despliega en Railway.
AFRODITA_DATA_DIR=

# Configuración opcional de IA: si se define una, deben definirse las tres.
AFRODITA_AI_CHAT_COMPLETIONS_URL=
AFRODITA_AI_API_KEY=
AFRODITA_AI_MODEL=

# Opcionales: lectura del catálogo público mediante
# public.get_afrodita_verified_catalog(group_id). Usa una clave publishable o
# la clave JWT legacy con role=anon. Nunca uses service_role ni una clave sb_secret.
# La RPC solo devuelve nombres de verificadas para grupos habilitados
# explícitamente en la allowlist administrada por service_role.
AFRODITA_SUPABASE_URL=
AFRODITA_SUPABASE_KEY=
