{
  "name": "afrodita-telegram-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bot social para descubrir productos y servicios locales en Telegram",
  "main": "dist/bot.js",
  "scripts": {
    "dev": "tsx watch src/bot.ts",
    "build": "tsc",
    "start": "node dist/bot.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json"
  },
  "type": "module",
  "dependencies": {
    "dotenv": "^17.4.2",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
